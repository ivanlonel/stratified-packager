{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "America/Sao_Paulo",
  "schedule": [
    // Before 8am every Monday.
    "* 0-7 * * 1"
  ],
  "minimumReleaseAge": "1 day",
  // Skip releases that drop the oldest Python requires-python accepts (sphinx 9.2 needs
  // >=3.13: #98). A bare version, not the ">=3.12" range Renovate extracts from pyproject.toml:
  // pep440 versioning has no subset(), so strict filtering falls back to matches(), which needs
  // a bare version and would drop nearly every release against a range. Keep it at
  // pyproject.toml's requires-python floor.
  "constraints": {
    "python": "3.12"
  },
  "constraintsFiltering": "strict",
  "prHourlyLimit": 5,
  // Automatically merge updates if CI build status is passing.
  "automerge": true,
  "automergeStrategy": "squash",
  // The pep621 and pre-commit managers are not enabled by default.
  // github-actions is enabled by default and listed here for explicitness.
  "enabledManagers": [
    "github-actions",
    "pep621",
    "pre-commit",
    // Enables the custom regex manager below (tracks the QGIS Chocolatey packages
    // pinned in the Windows QA matrix). enabledManagers is a strict allowlist, so
    // custom.regex must be named explicitly or the custom manager never runs.
    "custom.regex"
  ],
  // pre-commit support is currently in beta and requires explicit opt-in.
  "pre-commit": {
    "enabled": true
  },
  // main's ruleset doesn't require branches to be up to date: with it, GitHub's native
  // auto-merge never refreshes a stale branch, so each merge stalled every sibling PR until the
  // next Renovate run rebased it (and human PRs forever). Rebasing a PR that's merely behind
  // would now only re-run the CI matrix, and main's own push CI covers the combination. Not
  // the "auto" default: that resolves to behind-base-branch here through automerge=true.
  "rebaseWhen": "conflicted",
  // The Post-Renovate Hooks workflow commits the sync-with-uv / pyproject-fmt results onto
  // pep621 + pre-commit branches as github-actions[bot] (author and committer). Renovate
  // counts a branch carrying a foreign commit author OR committer as modified and then refuses
  // to rebase it, so without this those PRs would need the manual tick on conflict. The flip side:
  // Renovate is then free to rebuild such a branch, dropping that commit for the workflow to
  // re-add, so no pep621 update may be lockfile-only (see vulnerabilityAlerts below).
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  // Raise PRs for known vulnerabilities from the osv.dev database, independent of the schedule.
  "osvVulnerabilityAlerts": true,
  // Security PRs default to rangeStrategy "update-lockfile" (a uv.lock-only change), which is
  // forced over the pep621 rule below. pep621 has no updateLockedDependency, so Renovate can't
  // tell that such a branch is still current: once the Post-Renovate Hooks commit lands, every
  // run re-locks against the base branch's uv.lock, sees a change and rebuilds the branch from
  // main without that commit, which the workflow then re-adds -- an endless force-push loop
  // (#80). With a bumped range, Renovate finds the bump already on the branch and leaves it
  // alone, as on every other pep621 PR.
  "vulnerabilityAlerts": {
    "rangeStrategy": "bump"
  },
  // The weekly `uv lock --upgrade`, which keeps transitive dependencies that no other
  // Renovate PR touches current instead of piling up as Dependabot security PRs, runs in the
  // Post-Renovate Hooks workflow on the weekly "pep621 and pre-commit" PR instead. There
  // sync-with-uv re-pins the hooks to the refreshed lock in the same commit. Renovate's own
  // maintenance branch is lockfile-only, so it would be rebuilt on every run once that commit
  // landed (#80), and its pins would lag the lock.
  "lockFileMaintenance": {
    "enabled": false
  },
  // Renovate has no Chocolatey datasource, so the QGIS / QGIS-LTR Chocolatey
  // packages pinned in the Windows QA matrix (.github/workflows/testing.yml) are tracked
  // by querying the Chocolatey community feed (a NuGet v2 OData API) through the
  // nuget datasource. depName is the choco package id captured from qgis_variant;
  // the version comes from the adjacent qgis_version line.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/testing\\.yml$/"
      ],
      // RE2 matches per-file (not per-line), so \s spans the newline + indentation
      // between the paired qgis_variant / qgis_version lines. Quotes are optional to
      // tolerate either YAML quoting style.
      "matchStrings": [
        "qgis_variant:\\s*[\"']?(?<depName>[\\w.-]+)[\"']?\\s+qgis_version:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "nuget",
      // NOT nuget versioning: in NuGet a bare "3.44.12" is the range ">= 3.44.12", so
      // Renovate resolves currentVersion to the newest release, finds the range already
      // satisfied and never proposes an update (pinning it the NuGet way, "[3.44.12]", is
      // not an option -- choco install --version needs the bare string). loose treats the
      // value as the exact version it is, and tolerates choco's occasional 4-part versions.
      "versioningTemplate": "loose",
      "registryUrlTemplate": "https://community.chocolatey.org/api/v2/"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": [
        // Don't suggest upgrades for the project's required Python version.
        "python"
      ],
      "enabled": false
    },
    {
      // Don't suggest upgrades for the pre-commit repos themselves. That's done
      // by sync-with-uv in the workflow, which mirrors each repo's rev from the
      // tool pinned in uv.lock, so a Renovate PR would only fight it. The next rule
      // carves out the repos whose tool ISN'T in uv.lock, which sync-with-uv can't
      // keep current.
      "matchManagers": [
        "pre-commit"
      ],
      "matchDepTypes": [
        "repository"
      ],
      "enabled": false
    },
    {
      // Same for the Python additional_dependencies: every one carries a
      // `# sync-with-uv` pragma, so sync-with-uv pins it to its exact uv.lock
      // version (pep621 bumps it in pyproject.toml's hook/dev groups). That keeps each
      // hook environment from re-resolving to newer releases on a cache miss, so a
      // checker only changes on the PR that changes uv.lock, where it then runs on
      // every file. Go dependencies (actionlint's shellcheck) stay Renovate's.
      "matchManagers": [
        "pre-commit"
      ],
      "matchDepTypes": [
        "pre-commit-python"
      ],
      "enabled": false
    },
    {
      // Re-enable the pre-commit repos with no uv.lock-pinned tool for sync-with-uv
      // to track (no PyPI distribution / non-Python tools), so Renovate owns their
      // rev bumps. Keep this list aligned with .pre-commit-config.yaml.
      "matchManagers": [
        "pre-commit"
      ],
      "matchDepTypes": [
        "repository"
      ],
      "matchDepNames": [
        "pre-commit/pygrep-hooks",
        "renovatebot/pre-commit-hooks",
        "rhysd/actionlint"
      ],
      "enabled": true
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "addLabels": [
        "pre-commit"
      ]
    },
    {
      "matchManagers": [
        "pep621"
      ],
      "addLabels": [
        "pep621"
      ]
    },
    {
      // One PR for the week's action bumps instead of one per action. Majors still get a
      // separate "(major)" group PR: separateMajorMinor outranks packageRule groups.
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      // QGIS is pulled from the Chocolatey community feed by the custom.regex
      // manager (see customManagers), so tag those PRs `chocolatey` to match how the
      // other ecosystems are labelled. (The path labeler also adds `ci-cd` for the
      // workflow-file edit.)
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "qgis",
        "qgis-ltr"
      ],
      "addLabels": [
        "chocolatey"
      ],
      // Give patch its own bucket instead of the default shared "non-major" one, which keeps
      // only the highest candidate: the 3.40 pin would see 3.44.x (dropped as minor by the
      // next rule) and never be offered its own 3.40.x patch. It also splits the branch topic
      // per line (qgis-ltr-3.40.x / -3.44.x), which would otherwise collide on qgis-ltr-3.x.
      // Must live here and not on the rule below: a rule carrying matchUpdateTypes never
      // matches before lookup, which is where bucketing happens.
      "separateMinorPatch": true
    },
    {
      // Only bump the micro (patch) version of the QGIS Chocolatey packages so CI
      // keeps exercising the pinned major.minor lines (the qgis_line values 3.40, 3.44,
      // 4.2). Major/minor moves change the tested QGIS baseline, and they also rename the
      // required status checks, so they stay a deliberate, manual edit paired with a
      // ruleset update.
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "qgis",
        "qgis-ltr"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      // Group pep621 and pre-commit updates into a single PR so the pre-commit
      // additional_dependencies and pyproject.toml deps land together.
      "matchManagers": [
        "pep621",
        "pre-commit"
      ],
      "groupName": "pep621 and pre-commit",
      "groupSlug": "pep621-pre-commit",
      // Bump the range even if the new version satisfies the existing range.
      "rangeStrategy": "bump"
    },
    {
      // prek-action installs prek at `latest` unless told otherwise, so its `prek-version`
      // input is pinned to uv.lock's prek. The github-actions manager tracks that input
      // natively (as `prek`, from j178/prek's v-prefixed GitHub releases), and this rule,
      // placed after the github-actions group, moves it with the dev group's prek in the
      // same PR.
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "prek"
      ],
      "groupName": "pep621 and pre-commit",
      "groupSlug": "pep621-pre-commit"
    }
  ]
}
